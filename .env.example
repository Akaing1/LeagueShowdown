# Required. Choose a long private password before starting the backend.
SHOWDOWN_HOST_PASSWORD=replace-with-a-long-private-password
SHOWDOWN_DB=data/showdown.sqlite3
# Optional replacement for the built-in server-only question pack:
# SHOWDOWN_QUESTIONS=/absolute/path/to/questions.json
# Set to 1 behind HTTPS in production:
SHOWDOWN_SECURE_COOKIE=0
